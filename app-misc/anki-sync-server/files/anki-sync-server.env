# Full reference: https://docs.ankiweb.net/sync-server.html

# One SYNC_USERn per account, in user:password form. SYNC_USER1 is mandatory.
#SYNC_USER1=user:changeme
#SYNC_USER2=other:changeme

# Set to any value to interpret the above as user:hash instead, where hash is a
# PHC-format string. Generate one with e.g. https://git.sr.ht/~laalsaas/pbkdf2-password-hash
#PASSWORDS_HASHED=1

# Listen address. Plain HTTP -- keep it off public interfaces.
SYNC_HOST=127.0.0.1
SYNC_PORT=8781

# Upload cap in MB; upstream default matches AnkiWeb's 100. Raise it (and the
# corresponding limit in your reverse proxy) if you sync large media sets.
#MAX_SYNC_PAYLOAD_MEGS=200
